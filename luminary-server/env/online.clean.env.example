# Online clean production API.
# Set these in the cloud host's secret/environment manager.
# Never reuse demo database URLs, demo API URLs, or seeded credentials here.

NODE_ENV=production
PORT=4000
NODE_ID=cloud
DATABASE_URL=postgres://luminary_app:replace-with-db-password@production-db-host:5432/luminary
DB_POOL_SIZE=10
CLIENT_FILE_STORAGE_PATH=/var/lib/luminary/client-files
WEB_ORIGINS=https://app.luminarytech.org
MESSAGING_DISPATCH=false
SHOW_TEST_PRACTICES=false
STT_PROVIDER=openai
STT_API_KEY=replace-with-openai-secret
STT_MODEL=gpt-4o-mini-transcribe
CLINICAL_AI_PROVIDER=openai
CLINICAL_AI_MODEL=gpt-5-nano
