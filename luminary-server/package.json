{
  "name": "luminary-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Luminary Health API \u2014 runs identically in cloud and on a practice's local server",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:env": "node --env-file=.env --import tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:env": "node --env-file=.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "migrate": "node --import tsx scripts/migrate.ts",
    "migrate:env": "node --env-file=.env --import tsx scripts/migrate.ts",
    "migrate:local-clean": "node --env-file=env/local.clean.env --import tsx scripts/migrate.ts",
    "migrate:local-demo": "node --env-file=env/local.demo.env --import tsx scripts/migrate.ts",
    "migrate:online-clean": "node --env-file=env/online.clean.env --import tsx scripts/migrate.ts",
    "migrate:online-demo": "node --env-file=env/online.demo.env --import tsx scripts/migrate.ts",
    "bootstrap:practice": "node --env-file=.env --import tsx scripts/bootstrap-live-practice.ts",
    "bootstrap:local-clean": "node --env-file=env/local.clean.env --import tsx scripts/bootstrap-live-practice.ts",
    "check:local-clean": "node --env-file=env/local.clean.env scripts/assert-clean-env.mjs local-clean",
    "check:online-clean": "node --env-file=env/online.clean.env scripts/assert-clean-env.mjs online-clean",
    "seed:passwords": "node --import tsx scripts/seed-passwords.ts",
    "seed:test-roles": "node --import tsx scripts/seed-test-roles.ts",
    "seed:demo": "node --env-file=env/local.demo.env --import tsx scripts/seed-demo-data.ts",
    "seed:online-demo": "node --env-file=env/online.demo.env --import tsx scripts/seed-demo-data.ts",
    "setup:local-clean": "npm run check:local-clean && npm run migrate:local-clean",
    "setup:online-clean": "npm run check:online-clean && npm run migrate:online-clean",
    "setup:local-demo": "npm run migrate:local-demo && npm run seed:demo",
    "setup:online-demo": "npm run migrate:online-demo && npm run seed:online-demo",
    "docker:local-clean:db": "docker compose --env-file env/local.clean.env -f compose.local.clean.yaml up -d db-clean",
    "docker:local-clean:api": "docker compose --env-file env/local.clean.env -f compose.local.clean.yaml up --build api-clean",
    "docker:local-clean": "npm run docker:local-clean:db && npm run setup:local-clean && npm run docker:local-clean:api",
    "docker:local-demo:db": "docker compose -f compose.local.demo.yaml up -d db-demo",
    "docker:local-demo:api": "docker compose -f compose.local.demo.yaml up --build api-demo",
    "docker:local-demo": "npm run docker:local-demo:db && npm run setup:local-demo && npm run docker:local-demo:api",
    "docker:online-clean:api": "docker compose --env-file env/online.clean.env -f compose.online.clean.yaml up --build -d api",
    "docker:online-demo:api": "docker compose --env-file env/online.demo.env -f compose.online.demo.yaml up --build -d api-demo",
    "deploy:online-clean": "npm run setup:online-clean && npm run docker:online-clean:api",
    "deploy:online-demo": "npm run setup:online-demo && npm run docker:online-demo:api",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "contract:permissions": "tsx scripts/contract-permissions.ts",
    "verify:integration": "tsx scripts/verify-integration.ts",
    "verify:executive-insight": "node --env-file=env/local.demo.env --import tsx scripts/verify-executive-insight.ts",
    "test:insight": "tsx --test src/modules/executive-insight/*.test.ts",
    "verify:claims": "tsx scripts/verify-claims.ts",
    "verify:scenario013": "node --import tsx scripts/scenario013-smoke.mjs",
    "verify:scenario014": "node --import tsx scripts/scenario014-smoke.mjs",
    "verify:scenario015": "node --import tsx scripts/scenario015-smoke.mjs",
    "verify:scenario016": "node --import tsx scripts/scenario016-smoke.mjs",
    "verify:scenario017": "node --import tsx scripts/scenario017-smoke.mjs",
    "verify:scenario018": "node --import tsx scripts/scenario018-smoke.mjs",
    "verify:dictation": "node --import tsx scripts/doctor-dictation-smoke.mjs",
    "report:suspicious-national-ids": "node scripts/report-suspicious-national-ids.mjs",
    "verify:scenario007": "node scripts/scenario007-smoke.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "argon2": "^0.31.2",
    "fastify": "^4.26.0",
    "pg": "^8.11.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
