# Local demo server with seeded demo data.
# Copy to env/local.demo.env. This database is disposable.

NODE_ENV=development
PORT=4001
NODE_ID=local-demo
DATABASE_URL=postgres://luminary_app:change-me-demo@127.0.0.1:54321/luminary_demo
DB_POOL_SIZE=10
CLIENT_FILE_STORAGE_PATH=./client-files-demo
WEB_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5175,http://localhost:5175
MESSAGING_DISPATCH=false
SHOW_TEST_PRACTICES=true
STT_PROVIDER=mock
CLINICAL_AI_PROVIDER=mock
LUMINARY_DEMO_PASSWORD=LuminaryDemo2026!
