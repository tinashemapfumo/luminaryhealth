# Local clean clinic server.
# Copy to env/local.clean.env and replace every placeholder before real use.

NODE_ENV=production
PORT=4000
NODE_ID=clinic-local
DATABASE_URL=postgres://luminary_app:replace-with-local-db-password@127.0.0.1:54320/luminary
LOCAL_POSTGRES_PASSWORD=replace-with-local-db-password
DB_POOL_SIZE=10
CLIENT_FILE_STORAGE_PATH=./client-files-clean
WEB_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
MESSAGING_DISPATCH=false
SHOW_TEST_PRACTICES=false
STT_PROVIDER=mock
CLINICAL_AI_PROVIDER=mock

# Required only when bootstrapping a first real practice.
BOOTSTRAP_PRACTICE_NAME=Luminary Clinic
BOOTSTRAP_PRACTICE_SHORT_NAME=Luminary
BOOTSTRAP_PRACTICE_CITY=Harare
BOOTSTRAP_PRIMARY_CURRENCY=USD
BOOTSTRAP_TIMEZONE=Africa/Harare
BOOTSTRAP_ADMIN_EMAIL=admin@your-practice.example
BOOTSTRAP_ADMIN_FULL_NAME=Practice Administrator
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-password
