# Online demo API. Use a separate app and a separate disposable database.
# Never point this at the clean production database.

NODE_ENV=production
PORT=4000
NODE_ID=cloud-demo
DATABASE_URL=postgres://luminary_app:change-me@demo-db-host:5432/luminary_demo
DB_POOL_SIZE=10
CLIENT_FILE_STORAGE_PATH=/var/lib/luminary-demo/client-files
WEB_ORIGINS=https://app.luminarytech.org
MESSAGING_DISPATCH=false
SHOW_TEST_PRACTICES=true
STT_PROVIDER=mock
CLINICAL_AI_PROVIDER=mock
LUMINARY_DEMO_PASSWORD=LuminaryDemo2026!
LUMINARY_ALLOW_PRODUCTION_TEST_SEED=true
