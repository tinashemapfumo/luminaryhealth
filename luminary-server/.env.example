# Cloud deployment
NODE_ENV=development
PORT=4000
NODE_ID=cloud
DATABASE_URL=postgres://luminary_app:change-me@localhost:5432/luminary

# Shared secret for node-to-node replication. Absent means replication is off.
# SYNC_SECRET=change-me

# A practice's local server instead looks like:
# NODE_ID=harare-central-local
# DATABASE_URL=postgres://luminary_app:change-me@localhost:5432/luminary
# SYNC_PEER_URL=https://api.luminaryhealth.co.zw
# SYNC_INTERVAL_SECONDS=30
# SYNC_SECRET=change-me
#
# The practice this node serves. A node is provisioned with this and the secret,
# and learns everything else from the peer — including its own practice row,
# which cannot arrive through tenant-scoped replication because it *is* the
# tenant. Unset on cloud, which serves many practices and initiates nothing.
# SYNC_PRACTICE_ID=00000000-0000-0000-0000-000000000000
